# ============================================
# 🐳 DOCKER LOCAL - VARIABLES DE ENTORNO
# ============================================
# Este archivo contiene TODAS las variables necesarias
# para ejecutar el proyecto en Docker (desarrollo local)
# ============================================

# ============================================
# 🗄️ MYSQL CONFIGURATION
# ============================================
MYSQL_ROOT_PASSWORD=root_password_local_2024
MYSQL_DATABASE=peruana_informatica
MYSQL_USER=peruana_user
MYSQL_PASSWORD=peruana_password_local_2024

# ============================================
# 🔌 BACKEND - DATABASE CONNECTION
# ============================================
DB_HOST=mysql
DB_PORT=3306
DB_NAME=peruana_informatica
DB_USER=peruana_user
DB_PASSWORD=peruana_password_local_2024
DB_SYNC_ALTER=false

# ============================================
# 🚀 BACKEND - SERVER CONFIGURATION
# ============================================
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# ============================================
# 🎨 FRONTEND - SERVER CONFIGURATION  
# ============================================
# Next.js uses PORT 3000 by default, but we need to be explicit
# to avoid conflicts with backend's PORT variable
FRONTEND_PORT=3000

# ============================================
# 🔐 BACKEND - AUTHENTICATION
# ============================================
JWT_SECRET=docker-local-secret-key-super-seguro-CAMBIAR-en-produccion
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
SESSION_SECRET=docker-session-secret-key-CAMBIAR-en-produccion
BCRYPT_ROUNDS=10

# ============================================
# 📧 BACKEND - EMAIL CONFIGURATION (SMTP)
# ============================================
# Para Gmail: smtp.gmail.com, port 587
# Para Outlook: smtp-mail.outlook.com, port 587
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=noreply@peruanainformatica.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ============================================
# 🚀 BACKEND - REDIS CACHE (OPTIONAL)
# ============================================
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379
CACHE_TTL=300

# ============================================
# 🔑 BACKEND - API KEYS
# ============================================
GEMINI_API_KEY=your-gemini-api-key-here
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
UNSPLASH_ACCESS_KEY=your-unsplash-access-key-here

# ============================================
# 📤 BACKEND - FILE UPLOAD
# ============================================
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,image/gif
UPLOAD_DIR=public/images

# ============================================
# 🛡️ BACKEND - SECURITY & RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
SEARCH_RATE_LIMIT_MAX=500
LOGIN_RATE_LIMIT_MAX=5

# ============================================
# 📊 BACKEND - LOGGING
# ============================================
LOG_LEVEL=debug
ENABLE_REQUEST_LOGGING=true

# ============================================
# 💳 BACKEND - PAYMENT GATEWAYS
# ============================================
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000

# ============================================
# 🎨 FRONTEND - NEXT.JS CONFIGURATION
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:3001

# ============================================
# 🔐 FRONTEND - NEXTAUTH
# ============================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=docker-nextauth-secret-muy-segura-cambiala-en-produccion-12345

# ============================================
# 🔑 FRONTEND - GOOGLE AUTH
# ============================================
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# ============================================
# 🔗 EXTERNAL API
# ============================================
API_PERUANA_TOKEN=your-api-peruana-token-here
