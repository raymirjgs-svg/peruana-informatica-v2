# ======================
# 🗄️ DATABASE CONFIG
# ======================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=peruana_informatica
DB_USER=root
DB_PASSWORD=

# ======================
# 📧 EMAIL CONFIG (SMTP)
# ======================
# For Gmail: smtp.gmail.com, port 587
# For Outlook: smtp-mail.outlook.com, port 587
# For other providers, check their SMTP settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=noreply@peruanainformatica.com

# Gmail App Password Guide:
# 1. Enable 2-Factor Authentication
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Generate app password for "Mail"
# 4. Use that password here (not your regular Gmail password)

# Legacy SMTP variables (for compatibility)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Server Configuration
PORT=3001
NODE_ENV=development

# JWT Authentication (para cuando implementes usuarios)
JWT_SECRET=tu-secret-key-super-seguro-CAMBIAR-en-produccion-usar-aleatorio
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-email@gmail.com
SMTP_PASS=tu-app-password-aqui
EMAIL_FROM="Peruana de Informática <noreply@peruanainformatica.com>"

# ======================
# 🚀 REDIS CACHE CONFIG
# ======================
# Set to 'false' to disable Redis cache (app will work without Redis)
REDIS_ENABLED=false
# Redis connection URL
REDIS_URL=redis://localhost:6379
# Cache TTL in seconds (default: 5 minutes)
CACHE_TTL=300

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
SEARCH_RATE_LIMIT_MAX=500
LOGIN_RATE_LIMIT_MAX=5

# CORS Configuration
CORS_ORIGIN=http://127.0.0.1:3000,http://localhost:3000,https://037vk2mj-3000.uks1.devtunnels.ms

# API Keys
GEMINI_API_KEY=AIzaSyDBUP0Bb6-Qxd4PpyW5DqET28wpg3bsGvM
