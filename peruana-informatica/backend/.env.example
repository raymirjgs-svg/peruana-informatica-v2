# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=peruana_informatica
DB_USER=root
DB_PASSWORD=

# Server Configuration
PORT=3001
NODE_ENV=development

# Cron jobs (abandoned cart recovery + ERP product sync)
ENABLE_CRON=true

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
API_URL=http://localhost:3001

# Admin Panel URL (for email links)
ADMIN_URL=http://localhost:3000/admin

# API Externa - Peruana Informática
API_PERUANA_TOKEN=tu_token_aqui

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASS=tu-app-password-aqui

# Email del administrador (recibe notificaciones)
ADMIN_EMAIL=admin@peruanainformatica.com

# JWT Secret (obligatorio; el servidor no arranca sin él)
JWT_SECRET=tu-secreto-super-seguro-cambiar-en-produccion

# Redis (opcional; desactivar en entornos sin Redis)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# Mercado Pago
MP_ACCESS_TOKEN=tu_access_token_aqui
MP_PUBLIC_KEY=tu_public_key_aqui
MP_WEBHOOK_SECRET=tu_webhook_secret_aqui

# Google OAuth (login social en el frontend)
GOOGLE_CLIENT_ID=tu_google_client_id
GOOGLE_CLIENT_SECRET=tu_google_client_secret

# AI content generation
GEMINI_API_KEY=tu_gemini_api_key
OPENAI_API_KEY=tu_openai_api_key

# Unsplash (imágenes de blog)
UNSPLASH_ACCESS_KEY=tu_unsplash_access_key

# Logging
LOG_LEVEL=info
ENABLE_FILE_LOGGING=false
ENABLE_REQUEST_LOGGING=true

# Rate limiting
RATE_LIMIT_MAX_REQUESTS=1000
SEARCH_RATE_LIMIT_MAX=500
