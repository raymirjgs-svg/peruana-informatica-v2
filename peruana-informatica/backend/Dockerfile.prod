# ============================================
# 🐳 Backend Dockerfile - PRODUCTION (FIXED)
# ============================================

# 1. Base Image for dependencies
FROM node:20-alpine AS deps
WORKDIR /app
COPY package*.json ./
# Install production dependencies only
RUN npm ci

# 2. Builder Stage
FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
# Install ALL dependencies (including dev) to build typescript
RUN npm install
COPY . .
RUN npm run build

# 3. Production Runner Stage
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production

# Install basic tools for healthchecks
RUN apk add --no-cache wget curl

# --- FIX: COPY PACKAGE.JSON ---
# Copiamos package.json porque swagger.ts lo importa
COPY package.json ./

# Copy production node_modules from deps
COPY --from=deps /app/node_modules ./node_modules

# Copy built dist folder
COPY --from=builder /app/dist ./dist

# Copy public folder (images, uploads) if needed
COPY --from=builder /app/public ./public

# Create uploads directory
RUN mkdir -p /app/public/uploads && chmod 777 /app/public/uploads

# Expose backend port
EXPOSE 3001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:3001/api/health || exit 1

# Start server
CMD ["node", "dist/server.js"]
