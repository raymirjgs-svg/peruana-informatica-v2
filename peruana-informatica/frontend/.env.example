# API base URL WITHOUT the /api suffix (each endpoint appends it)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Public site URL (canonical links, metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=tu_nextauth_secret_aqui

# Google OAuth (must match the backend client id/secret)
GOOGLE_CLIENT_ID=tu_google_client_id
GOOGLE_CLIENT_SECRET=tu_google_client_secret

# Server-side calls to the API (Docker: http://backend:3001)
INTERNAL_API_URL=http://localhost:3001
